# ============================================================
# CargoCadence environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Never put real keys in this file.
# On Vercel, add the same variables under Project Settings -> Environment Variables.
# ============================================================

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: SERVER ONLY, bypasses RLS. Used by the Stripe webhook,
# the reminder route and the rate limiter. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Google Gemini (Google AI Studio -> API keys) ---
# Server only. Use your own key; the free tier has small daily limits,
# so production needs billing enabled.
GEMINI_API_KEY=your_gemini_api_key
# Model names change often. Check Google's current docs before deploying.
GEMINI_MODEL=gemini-3.7-flash
# Comma-separated fallbacks, tried in order if the main model is busy or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Optional: minimal | low | medium | high. "low" keeps replies fast.
GEMINI_THINKING_LEVEL=low

# --- Road distance (HeiGIT / openrouteservice: account.heigit.org) ---
ORS_API_KEY=your_openrouteservice_key

# --- Stripe (Dashboard -> Developers -> API keys; use TEST keys until go-live) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint in the Stripe Dashboard (production) or `stripe listen` (local)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Site URL (used for Stripe redirects) ---
# Local: http://localhost:3000   Production: your live https URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pickup reminders (Resend: resend.com -> API Keys) ---
RESEND_API_KEY=re_xxx
# Sender. The test sender only delivers to your own Resend account email.
# In production use an address on a domain verified in Resend.
RESEND_FROM_EMAIL=CargoCadence <onboarding@resend.dev>
# Where reminder emails go
ADMIN_NOTIFY_EMAIL=admin@example.com
# Long random secret. The scheduler sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate_a_long_random_string
# How many hours before pickup to remind the admin (default 24)
REMINDER_WINDOW_HOURS=24