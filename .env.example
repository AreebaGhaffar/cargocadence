NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.7-flash

ORS_API_KEY=your-openrouteservice-api-key

GEMINI_FALLBACK_MODEL=optional-backup-model-name

# Stripe (server only, use test keys in development)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public base URL of the site, used for Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase secret key (server only, bypasses RLS, never NEXT_PUBLIC)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Pickup reminders
RESEND_API_KEY=re_xxx
# Sender. Test sender only delivers to your own Resend account email.
# In production use an address on a domain verified in Resend.
RESEND_FROM_EMAIL=CargoCadence <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=admin@example.com
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate_a_long_random_string
# How many hours ahead of pickup to remind the admin (default 24)
REMINDER_WINDOW_HOURS=24